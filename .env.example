# Copie para .env e preencha apenas um provedor. Nunca versione sua chave.

# OpenAI (ou API compatível)
WHYLOG_API_KEY=
WHYLOG_BASE_URL=https://api.openai.com/v1
WHYLOG_MODEL=gpt-4o-mini

# Gemini nativo: descomente as três linhas e configure sua chave Google.
# WHYLOG_API_KEY=
# WHYLOG_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# WHYLOG_MODEL=gemini-2.5-flash
